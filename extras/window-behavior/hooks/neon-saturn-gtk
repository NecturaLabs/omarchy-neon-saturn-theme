#!/bin/bash
# Recolour GTK3/GTK4 (libadwaita) apps from the active theme's palette, so Files,
# dialogs and other GTK surfaces follow the theme rather than only its icons,
# and stop GTK from repainting a window when it loses focus.
# Installed by the Neon Saturn window-behavior extra; runs for every theme.
set -u
COLORS="$HOME/.local/state/omarchy/current/theme/colors.toml"
GTK3="$HOME/.config/gtk-3.0/gtk.css"
GTK4="$HOME/.config/gtk-4.0/gtk.css"
NOBACKDROP="$HOME/.config/gtk-3.0/adwaita-no-backdrop.css"
MARK="/* omarchy-neon-saturn: generated by the window-behavior extra, safe to delete */"

ours() {
  [[ ! -L $1 ]] && head -1 "$1" 2>/dev/null | grep -qF "$MARK"
}

reset() {
  for f in "$GTK3" "$GTK4" "$NOBACKDROP"; do
    [[ -f $f ]] && ours "$f" && rm -f "$f"
  done
}

# No palette to derive from means the generated files must go, not linger.
[[ -f $COLORS ]] || { reset; exit 0; }
command -v python3 >/dev/null 2>&1 || { reset; exit 0; }

# A gtk.css this hook did not write is the user's own: leave it alone.
SKIP3=0 SKIP4=0
if [[ -e $GTK3 || -L $GTK3 ]] && ! ours "$GTK3"; then
  SKIP3=1
  echo "neon-saturn-gtk: leaving $GTK3 alone, it was not generated by this hook" >&2
fi
if [[ -e $GTK4 || -L $GTK4 ]] && ! ours "$GTK4"; then
  SKIP4=1
  echo "neon-saturn-gtk: leaving $GTK4 alone, it was not generated by this hook" >&2
fi
(( SKIP3 && SKIP4 )) && exit 0

# Applies to every theme, light or dark: everything below is derived from
# colors.toml, so each theme gets its own treatment with no per-theme list to
# maintain. Light themes invert the surface ramp, which the map handles.
mode=$(omarchy-theme-color --file "$COLORS" mode 2>/dev/null || echo dark)

# Window rounding is part of a theme's identity, so GTK surfaces borrow the
# radius the compositor uses for that same theme. Omarchy reloads Hyprland before
# it runs theme-set hooks, so the live value already belongs to the new theme.
RADIUS=$(hyprctl getoption decoration:rounding -j 2>/dev/null |
  python3 -c 'import json, sys; print(int(json.load(sys.stdin)["int"]))' 2>/dev/null)
HYPR="$HOME/.local/state/omarchy/current/theme/hyprland.lua"
[[ -n $RADIUS ]] || RADIUS=$(sed -nE 's/.*\brounding[[:space:]]*=[[:space:]]*([0-9]+).*/\1/p' "$HYPR" 2>/dev/null | head -1)
[[ -n $RADIUS ]] || RADIUS=$(sed -nE 's/.*\brounding[[:space:]]*=[[:space:]]*([0-9]+).*/\1/p' \
  /usr/share/omarchy/default/hypr/looknfeel.lua 2>/dev/null | head -1)
[[ -n $RADIUS ]] || RADIUS=8

OUT3=$GTK3 OUT4=$GTK4
(( SKIP3 )) && OUT3=""
(( SKIP4 )) && OUT4=""

python3 - "$COLORS" "$OUT3" "$OUT4" "$MARK" "$RADIUS" "$mode" <<'PY'
import re, sys, os
colors, gtk3, gtk4, mark, radius, mode = sys.argv[1:7]
radius = int(radius)
light = mode == "light"
c = dict(re.findall(r'^\s*([a-z_]+)\s*=\s*"(#[0-9A-Fa-f]{6})"\s*$', open(colors).read(), re.M))
g = c.get
bg, fg = g("background"), g("foreground")
dbg, ddbg = g("dark_background", bg), g("darker_background", bg)
lbg, bfg = g("lighter_background", bg), g("bright_foreground", fg)
dfg, acc = g("dark_foreground", fg), g("accent")
red, green, yellow = g("red", acc), g("green", acc), g("yellow", acc)

def lum(h):
    r, gg, b = (int(h[i:i+2], 16) / 255 for i in (1, 3, 5))
    f = lambda c: c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
    return 0.2126 * f(r) + 0.7152 * f(gg) + 0.0722 * f(b)

def cr(a, b):
    la, lb = lum(a), lum(b)
    la, lb = max(la, lb), min(la, lb)
    return (la + 0.05) / (lb + 0.05)

def on(h):
    """Readable foreground for a filled swatch. A light theme's
    bright_foreground is dark, so a luminance guess picks the unreadable one;
    choose by measured contrast instead. Palette tones win while any of them
    clears AA, so the theme keeps its own colours; black/white are a fallback
    for accents no palette tone can sit on."""
    tones = (bfg, fg, ddbg, dbg, bg)
    best = max(tones, key=lambda t: cr(t, h))
    if cr(best, h) >= 4.5:
        return best
    return max(("#ffffff", "#000000"), key=lambda t: cr(t, h))

# Semantic surfaces. A dark theme recedes by getting darker, a light theme by
# getting darker too -- but its lightest tone is `background`, so the window
# and the content view swap places. Naming them by role keeps one token map.
if light:
    s_window, s_view, s_raised = dbg, bg, bg
    s_border, s_sunken, s_head = ddbg, ddbg, dbg
else:
    s_window, s_view, s_raised = bg, dbg, lbg
    s_border, s_sunken, s_head = lbg, ddbg, lbg
# libadwaita requires the *_shade_color family to be partially transparent black
SH, SH2 = "rgba(0, 0, 0, 0.36)", "rgba(0, 0, 0, 0.5)"

adw = {
  "window_bg_color": s_window, "window_fg_color": fg,
  "view_bg_color": s_view, "view_fg_color": fg,
  # Every *_backdrop_color deliberately equals its focused counterpart: with
  # follow_mouse, crossing a window would otherwise repaint it. The Hyprland
  # border glow is the only focus signal.
  "headerbar_bg_color": s_head, "headerbar_fg_color": bfg,
  "headerbar_border_color": s_border, "headerbar_backdrop_color": s_head,
  "headerbar_shade_color": SH, "headerbar_darker_shade_color": SH2,
  "sidebar_bg_color": s_head, "sidebar_fg_color": fg,
  "sidebar_backdrop_color": s_head, "sidebar_border_color": s_border,
  "sidebar_shade_color": SH,
  "secondary_sidebar_bg_color": s_head, "secondary_sidebar_fg_color": fg,
  "secondary_sidebar_backdrop_color": s_head, "secondary_sidebar_border_color": s_border,
  "secondary_sidebar_shade_color": SH,
  "card_bg_color": s_raised, "card_fg_color": fg, "card_shade_color": SH,
  "overview_bg_color": s_view, "overview_fg_color": fg,
  "thumbnail_bg_color": s_raised, "thumbnail_fg_color": fg,
  "active_toggle_bg_color": acc, "active_toggle_fg_color": on(acc),
  "dialog_bg_color": s_raised, "dialog_fg_color": fg,
  "popover_bg_color": s_raised, "popover_fg_color": fg, "popover_shade_color": SH,
  "shade_color": SH, "scrollbar_outline_color": s_sunken, "border_color": s_border,
  "accent_bg_color": acc, "accent_fg_color": on(acc), "accent_color": acc,
  "success_bg_color": green, "success_fg_color": on(green), "success_color": green,
  "warning_bg_color": yellow, "warning_fg_color": on(yellow), "warning_color": yellow,
  "error_bg_color": red, "error_fg_color": on(red), "error_color": red,
  "destructive_bg_color": red, "destructive_fg_color": on(red), "destructive_color": red,
}
gtk3_map = {
  "theme_bg_color": s_window, "theme_fg_color": fg,
  "theme_base_color": s_view, "theme_text_color": fg,
  "theme_selected_bg_color": acc, "theme_selected_fg_color": on(acc),
  "insensitive_bg_color": s_window, "insensitive_fg_color": dfg,
  # Unfocused mirrors focused exactly -- see the backdrop note above.
  "theme_unfocused_bg_color": s_window, "theme_unfocused_fg_color": fg,
  "theme_unfocused_base_color": s_view, "theme_unfocused_text_color": fg,
  "theme_unfocused_selected_bg_color": acc, "theme_unfocused_selected_fg_color": on(acc),
  "borders": s_border, "unfocused_borders": s_border,
  "warning_color": yellow, "error_color": red, "success_color": green,
}

# Design layer. Colors alone leave GTK apps wearing Adwaita's shapes, so carry
# two traits of the active theme across: the compositor's corner radius, and
# the Omarchy shell's own selection idiom (a tinted row with an accent label,
# not a solid accent slab). Content views keep Adwaita's strong fill, where a
# selection has to survive being scanned quickly.
design = f"""
/* --- theme design layer --- */

/* Corner radius borrowed from this theme's Hyprland rounding. */
.card,
.osd,
popover > contents,
popover > arrow,
.background > .dialog-vbox,
window.dialog .dialog-action-area,
.app-notification,
.toast {{
  border-radius: {radius}px;
}}
window.csd,
window.csd > .background,
window.messagedialog .response-area > button {{
  border-radius: {radius}px;
}}

/* Navigation lists (sidebars) echo the Omarchy menu: an 8% tint of the
   foreground, with the label in the accent, instead of a filled bar. */
.navigation-sidebar > row:selected,
.sidebar listview > row:selected,
.sidebar row.activatable:selected {{
  background-color: alpha({fg}, 0.08);
  color: {acc};
  border-radius: {radius}px;
}}
.navigation-sidebar > row:selected:hover,
.sidebar listview > row:selected:hover {{
  background-color: alpha({fg}, 0.12);
}}
.navigation-sidebar > row:hover,
.sidebar listview > row:hover {{
  background-color: alpha({fg}, 0.05);
  border-radius: {radius}px;
}}

/* Focus follows the accent rather than Adwaita's blue. */
*:focus-visible {{
  outline-color: alpha({acc}, 0.65);
  outline-offset: -2px;
}}

/* Focus must never repaint a window. Hyprland uses follow_mouse, so crossing a
   window focuses it, and Adwaita's backdrop styling would otherwise redraw
   every surface under the pointer. The *_backdrop_color tokens above already
   equal their focused counterparts; what follows cancels the rest of Adwaita's
   backdrop treatment one rule at a time, restating the focused declaration so
   nothing is dimmed, tinted or reshaped. A blanket `*:backdrop {{ opacity: 1 }}`
   cannot do this: it also erases the dimming a focused window applies to its
   own secondary labels and icons. The compositor's border glow stays the only
   focus signal. Mirrors libadwaita's stylesheet; recheck on a major update. */

/* Adwaita fades toolbars, tab bars and banners to half opacity in backdrop. */
headerbar:backdrop > windowhandle,
toolbarview > .top-bar:backdrop > windowhandle,
toolbarview > .bottom-bar:backdrop > windowhandle,
tabbar .box:backdrop > scrolledwindow,
tabbar .box:backdrop > .start-action,
tabbar .box:backdrop > .end-action,
searchbar > revealer > box:backdrop > *,
actionbar > revealer > box:backdrop > *,
banner > revealer > widget:backdrop > label,
banner > revealer > widget:backdrop > button {{
  filter: none;
}}

/* Banners and the file chooser's accept bar halve their tint in backdrop. */
banner > revealer > widget:backdrop {{
  background-color: color-mix(in srgb, var(--banner-color) 30%, var(--window-bg-color));
}}
.sidebar-pane banner > revealer > widget:backdrop {{
  background-color: color-mix(in srgb, var(--banner-color) 30%, var(--sidebar-bg-color));
}}
:not(.isolated) > .content-pane :not(.isolated) > .sidebar-pane banner > revealer > widget:backdrop,
:not(.isolated) > .sidebar-pane :not(.isolated) > .content-pane banner > revealer > widget:backdrop {{
  background-color: color-mix(in srgb, var(--banner-color) 30%, var(--secondary-sidebar-bg-color));
}}
filechooser scrolledwindow + actionbar > revealer > box:backdrop {{
  background-color: color-mix(in srgb, var(--accent-bg-color) 30%, var(--view-bg-color));
}}

/* Floating windows drop their client-side shadow in backdrop. Tiled, maximized
   and fullscreen windows already carry the same shadow in both states, so the
   selector leaves those to Adwaita rather than overriding them back. */
window.csd:not(.tiled):not(.tiled-top):not(.tiled-left):not(.tiled-right):not(.tiled-bottom):not(.maximized):not(.fullscreen):backdrop {{
  box-shadow: 0 0 14px 5px RGB(0 0 0/15%), 0 0 5px 2px RGB(0 0 0/10%), 0 0 0 1px RGB(0 0 0/5%);
}}
window.csd.dialog.message:backdrop,
window.csd.messagedialog:backdrop {{
  box-shadow: 0 0 14px 2px RGB(0 0 6/3%), 0 0 5px 2px RGB(0 0 6/10%), 0 0 0 1px RGB(0 0 0/5%);
}}
@media (prefers-contrast: more) {{
  window.csd:not(.tiled):not(.tiled-top):not(.tiled-left):not(.tiled-right):not(.tiled-bottom):not(.maximized):not(.fullscreen):backdrop {{
    box-shadow: 0 0 14px 5px RGB(0 0 0/15%), 0 0 5px 2px RGB(0 0 0/10%), 0 0 0 1px RGB(0 0 0/80%);
  }}
  window.csd.dialog.message:backdrop,
  window.csd.messagedialog:backdrop {{
    box-shadow: 0 0 14px 2px RGB(0 0 6/3%), 0 0 5px 2px RGB(0 0 6/10%), 0 0 0 1px RGB(0 0 0/80%);
  }}
}}
"""

def write(path, table, with_vars, extra="", prelude=()):
    if not path:
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    out = [mark, *prelude]
    out += [f"@define-color {k} {v};" for k, v in table.items() if v]
    if with_vars:
        # GTK 4.16+/libadwaita 1.6+ read these custom properties in preference
        out.append(":root {")
        out += [f"  --{k.replace('_', '-')}: {v};" for k, v in table.items() if v]
        out.append("}")
    if extra:
        out.append(extra)
    open(path, "w").write("\n".join(out) + "\n")

write(gtk4, adw, True, design)
# GTK3's Adwaita is compiled with its colours already resolved, so the names
# above reach only third-party stylesheets -- its own :backdrop rules are out of
# reach. The imported file, generated below, cancels them.
write(gtk3, gtk3_map, False)
PY

# GTK3 apps dim themselves when their window loses focus, in rules whose colours
# Adwaita resolved at build time. Restate each one with its focused value.
(( SKIP3 )) || {
python3 - /usr/lib/libgtk-3.so.0 "$mode" "$NOBACKDROP" "" <<'PY' && tail -n +2 "$NOBACKDROP" >>"$GTK3"
"""Generate a GTK3 stylesheet that cancels Adwaita's backdrop styling.

GTK3's Adwaita is compiled into libgtk-3 with its colours already resolved, so
a theme cannot reach its :backdrop rules through @define-color. This pairs each
:backdrop rule with the same selector's focused declarations and re-states them,
so an unfocused GTK3 window renders exactly like a focused one.
"""
import re, sys

# A backdrop rule may name a longhand where the focused rule used a shorthand,
# so each longhand lists the shorthands that can stand in for it.
STANDINS = {
    "background-color": ("background",),
    "background-image": ("background",),
    "background-size": ("background",),
    "background-repeat": ("background",),
    "background-position": ("background",),
    "background-clip": ("background",),
    "border-color": ("border",),
    "border-top-color": ("border-color", "border", "border-top"),
    "border-right-color": ("border-color", "border", "border-right"),
    "border-bottom-color": ("border-color", "border", "border-bottom"),
    "border-left-color": ("border-color", "border", "border-left"),
    "outline-color": ("outline",),
}

PAINT = {
    "color", "background-color", "background-image", "background", "opacity",
    "filter", "border-color", "border-top-color", "border-right-color",
    "border-bottom-color", "border-left-color", "box-shadow", "text-shadow",
    "-gtk-icon-shadow", "-gtk-icon-effect", "-gtk-icon-filter", "-gtk-icon-source",
    "outline-color", "caret-color", "background-size", "border-image",
}


def blob(path, want_dark):
    """Adwaita's compiled stylesheet for one colour variant, as a NUL-delimited
    string inside libgtk-3. Each blob is preceded by its resource file name,
    which is how Adwaita is told apart from the HighContrast themes shipped
    beside it; the light sheet is the plain `gtk-contained.css` nearest before
    the dark one. Located by content, so a GTK update only needs a re-run."""
    data = open(path, "rb").read()
    found = {}
    for m in re.finditer(rb"\x00([^\x00]{50000,})\x00", data):
        css = m.group(1).decode("utf-8", "replace")
        if ".background:backdrop" not in css:
            continue
        names = re.findall(rb"[\w.-]+\.css", data[max(0, m.start() - 96):m.start()])
        if names:
            found.setdefault(names[-1].decode(), []).append((m.start(), css))
    dark = found.get("gtk-contained-dark.css")
    light = found.get("gtk-contained.css")
    if not dark or not light:
        raise SystemExit("no Adwaita stylesheet found in %s" % path)
    if want_dark:
        return dark[0][1]
    before = [c for off, c in light if off < dark[0][0]]
    return before[-1] if before else light[-1][1]


def rules(css):
    css = re.sub(r"/\*.*?\*/", " ", css, flags=re.S)
    i, n, out = 0, len(css), []
    while i < n:
        j = css.find("{", i)
        if j < 0:
            break
        sel = css[i:j].strip()
        depth, k = 1, j + 1
        while k < n and depth:
            if css[k] == "{":
                depth += 1
            elif css[k] == "}":
                depth -= 1
            k += 1
        body = css[j + 1:k - 1]
        if sel.startswith("@"):
            if sel.split()[0] in ("@media", "@supports"):
                out.extend(rules(body))
        elif sel:
            out.append((sel, body))
        i = k
    return out


def decls(body):
    out = []
    for part in re.split(r";(?![^(]*\))", body):
        if ":" not in part:
            continue
        p, _, v = part.partition(":")
        p, v = p.strip(), " ".join(v.split())
        if p and v:
            out.append((p, v))
    return out


def split_group(sel):
    parts, depth, cur = [], 0, ""
    for ch in sel:
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
        if ch == "," and not depth:
            parts.append(cur.strip())
            cur = ""
        else:
            cur += ch
    if cur.strip():
        parts.append(cur.strip())
    return parts


def key(sel):
    """A selector's identity regardless of how its classes and pseudo-classes
    are ordered, so `button:backdrop.flat` pairs with `button.flat`."""
    out = []
    for step in re.split(r"(\s*[>+~]\s*|\s+)", sel.strip()):
        if not step.strip() or re.fullmatch(r"\s*[>+~]\s*|\s+", step):
            out.append(step.strip() or " ")
            continue
        parts = re.findall(r"(?:[.:#]{1,2}[\w-]+(?:\([^)]*\))?|\[[^\]]*\]|[\w*|-]+)", step)
        head = parts[0] if parts and parts[0][0] not in ".:#[" else ""
        rest = sorted(parts[1:] if head else parts)
        out.append(head + "".join(rest))
    return "".join(out)


def fallbacks(sel):
    """Selectors to consult when a :backdrop rule has no exact focused twin,
    least general first: Adwaita often styles the focused state through a
    broader rule (`tab`) than the backdrop one (`tab:checked.reorderable`)."""
    steps = re.split(r"(\s*[>+~]\s*|\s+)", sel.strip())
    tail = steps[-1]
    parts = re.findall(r"(?:[.:#]{1,2}[\w-]+(?:\([^)]*\))?|\[[^\]]*\]|[\w*|-]+)", tail)
    head = parts[0] if parts and parts[0][0] not in ".:#[" else ""
    rest = parts[1:] if head else parts
    out = []
    for n in range(len(rest) - 1, -1, -1):
        trimmed = head + "".join(rest[:n])
        if not trimmed:
            continue
        out.append("".join(steps[:-1]) + trimmed)
        out.append(trimmed)
    return out


def main(path, variant, out_path, title):
    parsed = rules(blob(path, variant == "dark"))
    focused = {}
    for sel, body in parsed:
        d = decls(body)
        for s in split_group(sel):
            if ":backdrop" in s:
                continue
            focused.setdefault(key(s), {}).update(d)

    emitted, unpaired = [], 0
    for sel, body in parsed:
        d = [(p, v) for p, v in decls(body) if p in PAINT]
        if not d:
            continue
        for s in split_group(sel):
            if ":not(:backdrop)" in s:
                # Focused-only paint; let it apply in both states.
                emitted.append((s.replace(":not(:backdrop)", ""), d))
                continue
            if ":backdrop" not in s:
                continue
            base = s.replace(":backdrop", "")
            sources = [focused.get(key(c)) for c in [base] + fallbacks(base)]
            sources = [src for src in sources if src]
            keep, taken = [], set()
            for prop, _ in d:
                for name in (prop,) + STANDINS.get(prop, ()):
                    hit = next((src[name] for src in sources if name in src), None)
                    if hit is None:
                        continue
                    if name not in taken:
                        taken.add(name)
                        keep.append((name, hit))
                    break
                else:
                    unpaired += 1
            if keep:
                emitted.append((s, keep))

    with open(out_path, "w") as f:
        f.write(title + "\n")
        for s, d in emitted:
            f.write("%s {\n%s\n}\n" % (s, "\n".join(f"  {p}: {v};" for p, v in d)))
    print(f"{out_path}: {len(emitted)} rules, {unpaired} unpaired")


if __name__ == "__main__":
    main(*sys.argv[1:4], sys.argv[4])
PY
rm -f "$NOBACKDROP"
}

# GTK reads gtk.css at startup; nudge the setting so newly drawn windows pick it up.
if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]] && command -v gsettings >/dev/null 2>&1; then
  cur=$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | tr -d "'")
  if [[ -n $cur ]]; then
    gsettings set org.gnome.desktop.interface gtk-theme "$cur-omarchy-reload" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface gtk-theme "$cur" 2>/dev/null || true
  fi
fi
